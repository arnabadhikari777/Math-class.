# Copy to .env and fill in. NEVER commit the real .env.
SECRET_KEY=change-me-to-a-long-random-string
TEACHER_USERNAME=
TEACHER_PASSWORD=

# Email (Gmail App Password) - needed for OTP / password-reset mail
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
EMAIL_SENDER_NAME=Arnab Math Class

# Web push (optional). Without these two keys push is simply not sent.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=

# Local development only
# FLASK_DEBUG=1
# FORCE_HTTPS=0

# Backend package options (defaults shown)
# BACKEND_AUTO_MIGRATE=1     # 0 = do not run migrations at startup
# ENFORCE_TEST_TIMER=0       # 1 = reject submissions after duration + 2 min

# ---- AI assistant (server-side only; never put these in templates or JS) ----
# API keys: fill in only the ones you have. A provider with an empty key is skipped.
GEMINI_API_KEY=
GROQ_API_KEY=            # one key covers gpt-oss, qwen and groq/compound
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=
TOGETHER_API_KEY=
CEREBRAS_API_KEY=
PERPLEXITY_API_KEY=
# Any other OpenAI-compatible service (all three needed; provider name = custom):
# CUSTOM_AI_BASE_URL=https://api.example.com/v1
# CUSTOM_AI_API_KEY=
# CUSTOM_AI_MODEL=

# ---- What students see: AI_NAME_<REAL AI> = name shown to students ----
# Left side = the REAL AI (so you always know which is which). Right side = any name you like.
# A student never sees the real AI name. Two AIs with the SAME name become ONE button
# (the first is tried first, the other is its backup). An AI with no name here is not used.
# Built-in defaults (used if you write nothing): GEMINI, GPT_OSS, QWEN, GROQ.
AI_NAME_GEMINI=Anubhab Dutta
AI_NAME_GPT_OSS=Arnab Adhikari
AI_NAME_QWEN=Arnab Adhikari
AI_NAME_GROQ=Arnab Adhikari
# New AIs - remove the # when you add its key above, and choose a name:
# AI_NAME_OPENAI=Rahul Sen
# AI_NAME_ANTHROPIC=
# AI_NAME_DEEPSEEK=
# AI_NAME_MISTRAL=
# AI_NAME_OPENROUTER=
# AI_NAME_XAI=
# AI_NAME_TOGETHER=
# AI_NAME_CEREBRAS=
# AI_NAME_PERPLEXITY=
# AI_NAME_CUSTOM=
# (AI_NAME_GPT_OSS is the Groq gpt-oss model, AI_NAME_GROQ is Groq compound; one GROQ_API_KEY covers all three.)

# ---- Optional tuning ----
# AI_PROVIDER_ORDER=gemini,gpt-oss       # global try/fallback order and button order; default = list order above
# Model overrides (defaults are in backend/ai/provider.py):
# GEMINI_MODEL=  GPT_OSS_MODEL=  QWEN_MODEL=  GROQ_COMPOUND_MODEL=  OPENAI_MODEL=  ANTHROPIC_MODEL=
# DEEPSEEK_MODEL=  MISTRAL_MODEL=  OPENROUTER_MODEL=  XAI_MODEL=  TOGETHER_MODEL=  CEREBRAS_MODEL=  PERPLEXITY_MODEL=
# AI_TIMEOUT_SECONDS=20                    # per provider (5-60)
# AI_RATE_PER_10MIN=20
# AI_RATE_PER_DAY=150
# AI_ENABLED=1                             # 0 hides the assistant for everyone
