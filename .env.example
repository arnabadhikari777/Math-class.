# Copy to .env and fill in. NEVER commit the real .env.
SECRET_KEY=change-me-to-a-long-random-string
TEACHER_USERNAME=
TEACHER_PASSWORD=

# Email (Gmail App Password) - needed for OTP / password-reset mail
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
EMAIL_SENDER_NAME=Arnab Math Class

# Web push (optional). Without these two keys push is simply not sent.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=

# Local development only
# FLASK_DEBUG=1
# FORCE_HTTPS=0

# Backend package options (defaults shown)
# BACKEND_AUTO_MIGRATE=1     # 0 = do not run migrations at startup
# ENFORCE_TEST_TIMER=0       # 1 = reject submissions after duration + 2 min

# ---- AI assistant (server-side only; never put these in templates or JS) ----
# At least one key is required. Default order tries all configured providers.
GEMINI_API_KEY=
GROQ_API_KEY=
# AI_PROVIDER_ORDER=gemini,gpt-oss,qwen,groq   # options: gemini, gpt-oss, qwen, groq
# GEMINI_MODEL=gemini-3.5-flash-lite
# GPT_OSS_MODEL=openai/gpt-oss-120b
# QWEN_MODEL=qwen/qwen3.8-27b
# GROQ_COMPOUND_MODEL=groq/compound
# AI_TIMEOUT_SECONDS=20                    # per provider (5-60)
# AI_RATE_PER_10MIN=20
# AI_RATE_PER_DAY=150
# AI_ENABLED=1                             # 0 hides the assistant for everyone
