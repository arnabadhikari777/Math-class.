# ============================================
# Arnab Math Class — Environment Variables
# ============================================


# Flask Session Secret Key
SECRET_KEY=


# Teacher Admin Login
TEACHER_USERNAME=
TEACHER_PASSWORD=


EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
EMAIL_SENDER_NAME=Arnab Math Class


VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=


# ============================================
# Cloudinary (Question Bank-এর ছবি) - cloudinary.com Dashboard থেকে নাও। Secret কখনো GitHub-এ দেবে না।
# ============================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=arnab-math-class       # optional
# BANK_IMAGE_MAX_MB=5                      # optional, প্রতি ছবি (1-10)


# ============================================
# AI KEYS - key বসালে ওই AI উত্তর দেয়; key খালি থাকলে সেটা উত্তর দেবে না (পরের AI দেবে)।
# (Key কখনো template/JS/GitHub-এ যায় না; শুধু সার্ভারের .env-এ থাকে।)
# ============================================
GEMINI_API_KEY=
GROQ_API_KEY=            # একটা key-তে গ্রুপের gpt-oss আর compound চলে (QWEN_API_KEY না থাকলে Qwen-ও)
QWEN_API_KEY=            # Qwen সরাসরি Alibaba থেকে; খালি থাকলে Qwen Groq-এর key দিয়ে চলে
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=
TOGETHER_API_KEY=
CEREBRAS_API_KEY=
PERPLEXITY_API_KEY=

# অন্য যেকোনো OpenAI-compatible সার্ভিস (তিনটাই লাগবে; AI-এর নাম = CUSTOM):
# CUSTOM_AI_BASE_URL=https://api.example.com/v1
# CUSTOM_AI_API_KEY=
# CUSTOM_AI_MODEL=

# ============================================
# ছাত্ররা কোন নাম দেখবে:  AI_NAME_<আসল AI> = ছাত্রদের নাম
# ============================================
# বাঁ দিকে আসল AI (তাই তুমি সবসময় বুঝবে কোনটা কোন AI), ডান দিকে যে নাম খুশি (বাংলাতেও চলবে)।
# ছাত্ররা আসল AI-এর নাম কখনো দেখে না; শুধু Sir-এর AI Chats পেজে দেখা যায়।
# দুই AI-কে একই নাম দিলে ছাত্ররা একটাই বোতাম দেখে: প্রথমটা আগে চলে, না চললে দ্বিতীয়টা।
# যে AI-এর নাম এখানে লেখা থাকবে সেটা ছাত্রদের বোতামে সবসময় দেখাবে, key থাকুক বা না থাকুক, কাজ করুক বা না করুক।
# ছাত্র এমন AI বাছলে বা সেটা ফেল করলে পরের চালু AI উত্তর দেয় (সাথে লেখা থাকে কে উত্তর দিল)।
# কোন AI কেন ফেল করছে জানতে: Sir-এর AI Chats পেজে "Test all AIs" চাপো।
# নাম খালি রাখলে: gemini/gpt-oss/qwen/groq-এর পুরোনো নাম, আর বাকিগুলো "AI 6" ধরনের নিরপেক্ষ নামে দেখায়।
AI_NAME_GEMINI=Anubhab Dutta
AI_NAME_GPT_OSS=GPT_OSS
AI_NAME_QWEN=QWEN
AI_NAME_GROQ=Arnab Adhikari

AI_NAME_OPENAI=OPENAI
AI_NAME_ANTHROPIC=
AI_NAME_DEEPSEEK=DEEPSEEK
AI_NAME_MISTRAL=MISTRAL
AI_NAME_OPENROUTER=OPENROUTER
AI_NAME_XAI=XAI
AI_NAME_TOGETHER=TOGETHER
AI_NAME_CEREBRAS=CEREBRAS
AI_NAME_PERPLEXITY=PERPLEXITY
# AI_NAME_CUSTOM=

# ============================================
# Optional tuning
# ============================================
# AI_PROVIDER_ORDER=gemini,gpt-oss       # শুধু এই AI-গুলো, এই ক্রমে (বোতামের ক্রমও এটাই); না দিলে সবগুলো
# Model বদলানো (default-গুলো backend/ai/provider.py-তে):
# GEMINI_MODEL=  GPT_OSS_MODEL=  QWEN_MODEL=  GROQ_COMPOUND_MODEL=  OPENAI_MODEL=  ANTHROPIC_MODEL=
# DEEPSEEK_MODEL=  MISTRAL_MODEL=  OPENROUTER_MODEL=  XAI_MODEL=  TOGETHER_MODEL=  CEREBRAS_MODEL=  PERPLEXITY_MODEL=
# QWEN_BASE_URL=                           # Qwen-এর অন্য region/endpoint লাগলে, যেমন https://dashscope.aliyuncs.com/compatible-mode/v1
# AI_TIMEOUT_SECONDS=20                    # প্রতিটা AI-এর জন্য (5-60)
# AI_RATE_PER_10MIN=20
# AI_RATE_PER_DAY=150
# AI_ENABLED=1                             # 0 দিলে সবার জন্য AI বন্ধ

# Marks: by default a total below 0 is shown as it is (correct x marks - wrong x negative marks).
# Set to 1 to stop the final score at 0 instead.
# MARKS_FLOOR_AT_ZERO=0
